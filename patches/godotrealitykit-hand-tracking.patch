+
+bool GDRKBridgeDelegate::beginHandTracking() const {
+    auto found = hand_views.find(window_id);
+    if (!hand_view || hand_view->closed || !hand_view->presented || !wantsHandTracking() ||
+            found == hand_views.end() || found->second.lock() != hand_view) { return false; }
+    auto current = hand_owner.lock();
+    if (current && current != hand_view) { return false; }
+    hand_owner = hand_view;
+    setHandTracked(kLeftHand, false);
+    setHandTracked(kRightHand, false);
+    return true;
+}
+
+void GDRKBridgeDelegate::endHandTracking() const {
+    if (!hand_view || hand_owner.lock() != hand_view) { return; }
+    setHandTracked(kLeftHand, false);
+    setHandTracked(kRightHand, false);
+    hand_owner.reset();
+}
+
+void GDRKBridgeDelegate::closeHandTrackingView() const {
+    endHandTracking();
+    if (!hand_view) { return; }
+    hand_view->closed = true;
+    hand_view->presented = false;
+    auto found = hand_views.find(window_id);
+    if (found != hand_views.end() && found->second.lock() == hand_view) { hand_views.erase(found); }
+}
