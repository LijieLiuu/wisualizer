+// Main-thread state shared by the native host and Swift copies of its bridge. A weak
+// map does not extend a closed view's lifetime, and replacement at the same Window ID
+// cannot let a deferred callback claim or invalidate the replacement's trackers.
+struct GDRKHandTrackingViewState {
+    uint64_t window_id;
+    bool presented = false;
+    bool closed = false;
+    std::array<GDRKHandTrackingFreshness, 2> samples;
+};
+static std::unordered_map<uint64_t, std::weak_ptr<GDRKHandTrackingViewState>> hand_views;
+static std::weak_ptr<GDRKHandTrackingViewState> hand_owner;
+
+static bool hand_sample_is_fresh(const std::shared_ptr<GDRKHandTrackingViewState> &p_view, int p_hand) {
+    if (!p_view || p_view->closed || !p_view->presented || hand_owner.lock() != p_view) { return false; }
+    auto found = hand_views.find(p_view->window_id);
+    if (found == hand_views.end() || found->second.lock() != p_view) { return false; }
+    return p_view->samples[p_hand].is_fresh(CACurrentMediaTime());
+}
 
