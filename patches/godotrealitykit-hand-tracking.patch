+// An explicit capability check for consumers requiring lifecycle-safe skeletal data.
+// XRHandTracker remains the data API; this is not a second hand-tracking provider.
+class RealityKitHandTracking : public godot::RefCounted {
+    GDCLASS(RealityKitHandTracking, godot::RefCounted);
+protected:
+    static void _bind_methods() {
+        godot::ClassDB::bind_method(godot::D_METHOD("get_api_revision"), &RealityKitHandTracking::get_api_revision);
+        godot::ClassDB::bind_method(godot::D_METHOD("is_immersive_presented", "window_id"), &RealityKitHandTracking::is_immersive_presented);
+        godot::ClassDB::bind_method(godot::D_METHOD("is_hand_sample_fresh", "window_id", "hand"), &RealityKitHandTracking::is_hand_sample_fresh);
+    }
+public:
+    int get_api_revision() const { return 2; }
+    // Read-only point-of-use guard. Hand 0 is left, hand 1 is right.
+    bool is_hand_sample_fresh(int64_t p_window_id, int64_t p_hand) const {
+        if (p_window_id < 0 || p_hand < 0 || p_hand > 1) { return false; }
+        auto found = hand_views.find(uint64_t(p_window_id));
+        return found != hand_views.end() && hand_sample_is_fresh(found->second.lock(), int(p_hand));
+    }
+    bool is_immersive_presented(int64_t p_window_id) const {
+        if (p_window_id < 0) { return false; }
+        auto found = hand_views.find(uint64_t(p_window_id));
+        if (found == hand_views.end()) { return false; }
+        auto state = found->second.lock();
+        return state && !state->closed && state->presented;
+    }
+};
