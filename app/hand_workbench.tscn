[gd_scene format=3]

[ext_resource type="Script" path="res://app/hand_workbench.gd" id="workbench"]

[node name="HandTools" type="VBoxContainer"]
script = ExtResource("workbench")
theme_override_constants/separation = 8

[node name="Instructions" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "Choose a fingertip, then use the other hand to pin A or B."

[node name="HandRow" type="HFlowContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 12

[node name="Hand" type="OptionButton" parent="HandRow"]
custom_minimum_size = Vector2(130, 44)
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Left hand"
popup/item_0/id = 0
popup/item_1/text = "Right hand"
popup/item_1/id = 1

[node name="Finger" type="OptionButton" parent="HandRow"]
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
item_count = 5
selected = 0
popup/item_0/text = "Index finger"
popup/item_0/id = 0
popup/item_1/text = "Thumb"
popup/item_1/id = 1
popup/item_2/text = "Middle finger"
popup/item_2/id = 2
popup/item_3/text = "Ring finger"
popup/item_3/id = 3
popup/item_4/text = "Little finger"
popup/item_4/id = 4

[node name="PinA" type="Button" parent="HandRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Pin A"
disabled = true

[node name="PinB" type="Button" parent="HandRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Pin B"
disabled = true

[node name="Reading" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "Waiting for hand tracking."

[node name="PinnedReading" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "A: not placed\nB: not placed"

[connection signal="item_selected" from="HandRow/Hand" to="." method="select_hand"]
[connection signal="item_selected" from="HandRow/Finger" to="." method="select_finger"]
[connection signal="pressed" from="HandRow/PinA" to="." method="pin" binds=[0]]
[connection signal="pressed" from="HandRow/PinB" to="." method="pin" binds=[1]]
