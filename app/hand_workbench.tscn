[gd_scene format=3]

[ext_resource type="Script" path="res://app/hand_workbench.gd" id="workbench"]
[ext_resource type="Script" path="res://app/hand_skeleton_view.gd" id="skeleton"]

[node name="HandWorkbench" type="Node"]
script = ExtResource("workbench")

[node name="Immersive" type="Window" parent="."]
own_world_3d = true
title = "Hand inspection"
size = Vector2i(1200, 1000)
visible = false

[node name="Origin" type="XROrigin3D" parent="Immersive"]

[node name="Head" type="XRCamera3D" parent="Immersive/Origin"]
current = true

[node name="Content" type="Node3D" parent="Immersive"]

[node name="Field" type="Node3D" parent="Immersive/Content"]

[node name="Skeleton" type="Node3D" parent="Immersive"]
script = ExtResource("skeleton")

[node name="Panel" type="Window" parent="."]
title = "Hand inspection controls"
size = Vector2i(1440, 1360)
min_size = Vector2i(960, 1000)
visible = false
placement = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Column" type="VBoxContainer" parent="Panel/Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Instructions" type="Label" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
autowrap_mode = 3
text = "Move a fingertip into the field box for a live scalar reading. Select a hand and finger, then use the other hand to pin A or B."

[node name="Fields" type="OptionButton" parent="Panel/Margin/Scroll/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
clip_text = true

[node name="HandRow" type="HFlowContainer" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
theme_override_constants/h_separation = 12

[node name="Hand" type="OptionButton" parent="Panel/Margin/Scroll/Column/HandRow"]
custom_minimum_size = Vector2(130, 44)
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Left hand"
popup/item_0/id = 0
popup/item_1/text = "Right hand"
popup/item_1/id = 1

[node name="Finger" type="OptionButton" parent="Panel/Margin/Scroll/Column/HandRow"]
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
item_count = 5
selected = 0
popup/item_0/text = "Index finger"
popup/item_0/id = 0
popup/item_1/text = "Thumb"
popup/item_1/id = 1
popup/item_2/text = "Middle finger"
popup/item_2/id = 2
popup/item_3/text = "Ring finger"
popup/item_3/id = 3
popup/item_4/text = "Little finger"
popup/item_4/id = 4

[node name="Reading" type="Label" parent="Panel/Margin/Scroll/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
autowrap_mode = 3
text = "Waiting for tracked hands."

[node name="PinRow" type="HFlowContainer" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
theme_override_constants/h_separation = 12

[node name="PinA" type="Button" parent="Panel/Margin/Scroll/Column/PinRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Pin A"
disabled = true

[node name="PinB" type="Button" parent="Panel/Margin/Scroll/Column/PinRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Pin B"
disabled = true

[node name="History" type="Button" parent="Panel/Margin/Scroll/Column/PinRow"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "History and export…"

[node name="PinnedHeading" type="Label" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
autowrap_mode = 3
text = "Pinned locations"

[node name="PinnedReading" type="Label" parent="Panel/Margin/Scroll/Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "A: not placed\nB: not placed"

[node name="PlaybackRow" type="HFlowContainer" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
theme_override_constants/h_separation = 12

[node name="Previous" type="Button" parent="Panel/Margin/Scroll/Column/PlaybackRow"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Previous frame"

[node name="Playback" type="Button" parent="Panel/Margin/Scroll/Column/PlaybackRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Play"

[node name="Next" type="Button" parent="Panel/Margin/Scroll/Column/PlaybackRow"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Next frame"

[node name="SizeLabel" type="Label" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
text = "Field extent in meters"

[node name="Size" type="SpinBox" parent="Panel/Margin/Scroll/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
min_value = 0.15
max_value = 0.9
step = 0.05
value = 0.5
suffix = "m"

[node name="Placement" type="HFlowContainer" parent="Panel/Margin/Scroll/Column"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8

[node name="NearHand" type="Button" parent="Panel/Margin/Scroll/Column/Placement"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Move near fingertip"
disabled = true

[node name="TurnLeft" type="Button" parent="Panel/Margin/Scroll/Column/Placement"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Rotate −30°"

[node name="TurnRight" type="Button" parent="Panel/Margin/Scroll/Column/Placement"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Rotate +30°"

[node name="Reset" type="Button" parent="Panel/Margin/Scroll/Column/Placement"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Reset placement"

[node name="Status" type="Label" parent="Panel/Margin/Scroll/Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "Hand data stays live only while this space is active."

[node name="Return" type="Button" parent="Panel/Margin/Scroll/Column"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Return to windows"

[connection signal="close_requested" from="Immersive" to="." method="stop"]
[connection signal="close_requested" from="Panel" to="." method="stop"]
[connection signal="item_selected" from="Panel/Margin/Scroll/Column/Fields" to="." method="select_field"]
[connection signal="item_selected" from="Panel/Margin/Scroll/Column/HandRow/Hand" to="." method="select_hand"]
[connection signal="item_selected" from="Panel/Margin/Scroll/Column/HandRow/Finger" to="." method="select_finger"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PinRow/PinA" to="." method="pin" binds=[0]]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PinRow/PinB" to="." method="pin" binds=[1]]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PinRow/History" to="." method="open_history"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PlaybackRow/Previous" to="." method="step" binds=[-1]]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PlaybackRow/Playback" to="." method="toggle_play"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/PlaybackRow/Next" to="." method="step" binds=[1]]
[connection signal="value_changed" from="Panel/Margin/Scroll/Column/Size" to="." method="resize_field"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/Placement/NearHand" to="." method="place_near_hand"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/Placement/TurnLeft" to="." method="rotate_field" binds=[-0.5235988]]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/Placement/TurnRight" to="." method="rotate_field" binds=[0.5235988]]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/Placement/Reset" to="." method="reset_placement"]
[connection signal="pressed" from="Panel/Margin/Scroll/Column/Return" to="." method="stop"]
