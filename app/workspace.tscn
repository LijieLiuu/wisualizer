filters = PackedStringArray("*.glb ; GLB")
use_native_dialog = true

[node name="BOVFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import Brick Headers"
file_mode = 1
access = 2
use_native_dialog = true

[node name="ImageFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import Images"
file_mode = 1
access = 2
filters = PackedStringArray("*.png, *.jpg, *.jpeg, *.webp, *.svg ; Images")
use_native_dialog = true

[node name="AttachmentFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Include Source Files"
file_mode = 1
access = 2
use_native_dialog = true

[node name="NotesFile" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Import TXT Notes (BBCode)"
file_mode = 0
access = 2
filters = PackedStringArray("*.txt ; UTF-8 text")
use_native_dialog = true

[node name="ImportNotesChoice" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Import TXT Notes"
size = Vector2i(780, 240)
exclusive = true
ok_button_text = "Replace"
cancel_button_text = "Cancel"
dialog_autowrap = true
dialog_text = "Replace the current notes, or append the imported text?"

[node name="SaveAsFile" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Save As"
file_mode = 4
access = 2
filters = PackedStringArray("*.zip ; ZIP")
use_native_dialog = true

