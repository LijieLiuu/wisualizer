; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wisualizer"
run/main_scene="res://app/launcher.tscn"
config/version="0.1"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_loop_type.visionos="RealitySceneTree"

[display]

window/size/viewport_width=800
window/size/viewport_height=1040
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale.visionos=2.0

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotRealityKit/plugin.cfg")

[reality_kit]

presentation_style="2D Window"
handles_game_controller_events=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

[xr]

visionos/enable_controller_tracking=false
