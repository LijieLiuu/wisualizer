; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wisualizer"
run/main_scene="res://app/launcher.tscn"
config/version="0.1"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://branding/icon.png"
boot_splash/bg_color=Color(0.0666667, 0.12549, 0.188235, 1)
boot_splash/image="res://branding/splash.png"
boot_splash/stretch_mode=4
run/main_loop_type.visionos="RealitySceneTree"

[autoload]

SpatialWindows="*res://addons/spatial/spatial_windows.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=1040
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=2.0
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotRealityKit/plugin.cfg")

[reality_kit]

presentation_style="2D Window"

[gui]

theme/custom="res://ui/theme.tres"

[input]

play_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
previous_frame={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
next_frame={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

[xr]

visionos/enable_controller_tracking=true
